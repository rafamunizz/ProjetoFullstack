generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")  // <--- A versão estável aceita isso aqui!
}

model User {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String?
  senha String? 
}

model Contato {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  nome String
  email String
  orcamento String?
  mensagem String
  criadoEm DateTime @default(now())

}